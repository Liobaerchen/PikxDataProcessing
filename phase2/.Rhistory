stepLen = 0.1
diffusion = 1
border = 10
startt = 0.5*border
times = rep(NA,nwalks)
accuracy = rep(NA,nwalks)
results = matrix(NA,nsteps,nwalks)
for(w in 1:nwalks){
x = startt
for(s in 2:nsteps){
