threshold = 2000
input = matrix(sample(c(0,1),90, replace = T),ncol = 3)
output = sample(c(0,1),30, replace=T)
weights = rep(0.5,3)
activation = function(vec, weights, threshold){
activations = rep(NA, length(vec))
for(i in 1:length(vec)){
activations[i] = vec[i] * weights[i]
if(activations[i] > threshold){
activations[i] = 1
}else{
activations[i] = 0
}
}
return(activations)
}
for(i in 1:threshold){
for(p in 1:length(input[,1])){
activations = activation(input[p,],weights)
}
}
