x = startt
for(s in 2:nsteps){
x[s] = x[s-1] + rnorm(1,delta*stepLen,
diffusion * stepLen )
if(x[s]>border){
results[1:s,w] = x
results[(s+1):nsteps,w] = border
times[w] = stepLen*s
accuracy[w] = 1
break
}
if(x[s]<0){
results[1:s,w] = x
results[(s+1):nsteps,w] = 0
times[w] = stepLen*s
accuracy[w] = 0
break
}
if(s == nsteps){
results[1:s,w] = x
results[s+1:nsteps,w] = NA
times[w] = NA
accuracy[w] = NA
break
}
}
}
matplot(results, type = 'l')
